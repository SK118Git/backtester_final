class FeedStruct(ABC):
    def __init__(self, raw_feed, source_name:str):
        self.source_name = source_name 
        self.fetch_date = time.time()
        self.entries = self.populate_entries(raw_feed)
    @abstractmethod
    def populate_entries(self, raw_feed)->list[EntryStruct]:
        ... 
    



