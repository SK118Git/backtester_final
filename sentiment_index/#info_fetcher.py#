def output_feeds(list_feeds:list[FeedStruct])->pl.DataFrame:
    rows = [] 
    if len(list_feeds) == 0:
        return 
    for feed in list_feeds:
        for entry in feed.entries:
            rows.append({
                "source": feed.source_name,
                "publication_time": entry.publication_date,
                "fetch_time": feed.fetch_date,
                "title": entry.title,
                "summary": entry.summary,
                "link": entry.link
            })
    df = pl.DataFrame(rows).with_columns(
        pl.from_epoch("publication_time", time_unit="s").dt.replace_time_zone("UTC"),
        pl.from_epoch("fetch_time", time_unit="s").dt.replace_time_zone("UTC")
    )
    return df  


def append_save(df:pl.DataFrame, path: str):
    if os.path.exists(path):
        old = pl.read_parquet(path)
        combined = pl.concat([old, df])
    else: 
        combined = df
    combined = combined.unique(subset=["source", "link"], keep="first")
    combined.write_parquet(path)
    return 
    

def run_feed_parser(feed_sources:list[tuple[str, str, str]],path:str):
    l = []
    for (source_type, source_name, url) in feed_sources:
        parsed = parse_feed(source_type, source_name, url)
        if parsed is not None: 
            l.append(parsed)
        else: 
            print(f"Skipped {source_name} ({url})")
    df = output_feeds(l)
    if df is not None: 
        append_save(df, path)
    return 
    


